<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Neon Riders Prototype</title>
<style>
body {
  margin: 0;
  overflow: hidden;
  background: black;
  color: white;
  font-family: Arial;
}

#ui {
  position: absolute;
  top: 10px;
  left: 10px;
  font-size: 20px;
}

canvas {
  display: block;
}
</style>
</head>
<body>

<div id="ui">
Score: <span id="score">0</span>
</div>

<canvas id="gameCanvas"></canvas>

<script>
const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

let score = 0;

let horse = {
  x: canvas.width/2,
  y: canvas.height - 100,
  speed: 8
};

let arrows = [];
let targets = [];

document.addEventListener("mousemove", (e) => {
  horse.x = e.clientX;
});

document.addEventListener("click", () => {
  arrows.push({
    x: horse.x,
    y: horse.y,
    speed: 15
  });
});

function spawnTarget() {
  targets.push({
    x: Math.random() * canvas.width,
    y: -50,
    size: 30,
    speed: 4 + Math.random() * 3
  });
}

setInterval(spawnTarget, 1000);

function drawHorse() {
  ctx.fillStyle = "cyan";
  ctx.fillRect(horse.x - 25, horse.y - 25, 50, 50);
}

function drawArrows() {
  ctx.fillStyle = "yellow";
  arrows.forEach((arrow, index) => {
    arrow.y -= arrow.speed;
    ctx.fillRect(arrow.x - 2, arrow.y, 4, 20);

    if (arrow.y < 0) arrows.splice(index, 1);
  });
}

function drawTargets() {
  ctx.fillStyle = "red";
  targets.forEach((target, tIndex) => {
    target.y += target.speed;
    ctx.beginPath();
    ctx.arc(target.x, target.y, target.size, 0, Math.PI * 2);
    ctx.fill();

    arrows.forEach((arrow, aIndex) => {
      let dx = arrow.x - target.x;
      let dy = arrow.y - target.y;
      let dist = Math.sqrt(dx*dx + dy*dy);

      if (dist < target.size) {
        score += 10;
        document.getElementById("score").innerText = score;
        targets.splice(tIndex, 1);
        arrows.splice(aIndex, 1);
      }
    });

    if (target.y > canvas.height) {
      targets.splice(tIndex, 1);
    }
  });
}

function drawBackground() {
  ctx.fillStyle = "rgba(0,0,0,0.3)";
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  for (let i = 0; i < 50; i++) {
    ctx.fillStyle = "white";
    ctx.fillRect(Math.random()*canvas.width, Math.random()*canvas.height, 2, 2);
  }
}

function gameLoop() {
  drawBackground();
  drawHorse();
  drawArrows();
  drawTargets();
  requestAnimationFrame(gameLoop);
}

gameLoop();
</script>

</body>
</html>
